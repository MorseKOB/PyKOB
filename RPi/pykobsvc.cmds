#!/bin/bash
# PyKOB Headless Deployment Startup Entrypoint
cd /home/pi/PyKOB

# Force tmux to initialize its virtual room directly inside the PyKOB root
tmux new-session -d -s mrt_term -c /home/pi/PyKOB 'venv/bin/python src.py/MRT.py --Selector GPIO RPi/selector-spec.mrtsel'

#
## To connect to the virtual terminal:
## tmux attach -t mrt_term
##
## To disconnect from the virtual terminal while leaving MRT running (from within the terminal):
## CTRL-B D
#

